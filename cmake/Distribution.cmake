if(NOT CMAKE_BUILD_TYPE STREQUAL "Release")
    return()
endif()
set(CPACK_GENERATOR ZIP)
set(CPACK_PACKAGE_NAME HksrApi)
set(CPACK_PACKAGE_VERSION "${PROJECT_VERSION}")
set(CPACK_PACKAGE_FILE_NAME "HksrApi-${PROJECT_VERSION}-win64-msvc${MSVC_TOOLSET_VERSION}-Release")
set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY OFF)
set(CPACK_PACKAGING_INSTALL_PREFIX "/")
configure_file(cmake/package.json.in "${CMAKE_CURRENT_BINARY_DIR}/sdk-package.json" @ONLY)
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/sdk-package.json" DESTINATION .)
include(CPack)
