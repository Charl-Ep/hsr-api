foreach(REQUIRED SDK_BUILD SDK_SOURCE TEST_ROOT CONFIG GENERATOR INTERFACE_GENERATION)
    if(NOT DEFINED ${REQUIRED})
        message(FATAL_ERROR "Missing ${REQUIRED}")
    endif()
endforeach()
function(run)
    execute_process(COMMAND ${ARGV} RESULT_VARIABLE RESULT)
    if(NOT RESULT EQUAL 0)
        message(FATAL_ERROR "Installed consumer step failed: ${ARGV}")
    endif()
endfunction()
run("${CMAKE_COMMAND}" --install "${SDK_BUILD}" --config "${CONFIG}" --prefix "${TEST_ROOT}/sdk")
run("${CMAKE_COMMAND}" -S "${SDK_SOURCE}/tests/package" -B "${TEST_ROOT}/consumer" -G "${GENERATOR}"
    "-DCMAKE_BUILD_TYPE=${CONFIG}" "-DCMAKE_PREFIX_PATH=${TEST_ROOT}/sdk")
run("${CMAKE_COMMAND}" --build "${TEST_ROOT}/consumer" --config "${CONFIG}" --parallel 2)
if(EXISTS "${TEST_ROOT}/consumer/${CONFIG}/consumer.exe")
    run("${TEST_ROOT}/consumer/${CONFIG}/consumer.exe")
else()
    run("${TEST_ROOT}/consumer/consumer.exe")
endif()
set(ENV{PATH} "${TEST_ROOT}/sdk/bin;$ENV{PATH}")
run("${TEST_ROOT}/sdk/checks/abi${INTERFACE_GENERATION}/AbiCapabilitiesTests.exe"
    "${TEST_ROOT}/sdk/checks/abi${INTERFACE_GENERATION}/AbiConsumer.dll")
